# CodeGuard — Remote AI Mode credentials.
#
# Copy this file to `.env` and fill in your key:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed (FR-10).
# If DEEPSEEK_API_KEY is absent or blank, CodeGuard runs in Local Mode —
# that is a supported default state, not an error (PRD §6.3).

DEEPSEEK_API_KEY=

# Optional: override the model id. The default is deepseek-flash.
#
# A model id is a fact about your account and this endpoint, not a fact about
# DeepSeek — the default here was once `deepseek-v4.1-flash` and the live API
# rejected it, listing the names it accepts instead. If a scan ever fails with a
# 400 naming model ids, put one of those names here. No code change needed.
#
# CODEGUARD_MODEL=deepseek-flash
