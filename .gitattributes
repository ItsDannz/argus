# Normalize line endings in the repository to LF, regardless of the platform the
# contributor is on. This matters more than usual for CodeGuard: the tool parses
# unified diffs and installs a Git pre-commit hook, so stray CRLF characters in
# source or hook scripts cause real breakage (a CRLF shebang line, for instance,
# makes a hook script unrunnable on Unix).
* text=auto eol=lf

# Explicitly binary — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
