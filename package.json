{
  "name": "codeguard",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous Code Security Guard & Patch Agent — a pre-commit security and logic-bug scanner for Git.",
  "license": "MIT",
  "keywords": [
    "security",
    "devsecops",
    "git-hooks",
    "static-analysis",
    "llm",
    "deepseek"
  ],
  "bin": {
    "codeguard": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && tsc -p tsconfig.test.json && jest",
    "test:unit": "tsc -p tsconfig.test.json && jest --testPathIgnorePatterns \"e2e\"",
    "test:only": "jest"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.3",
    "inquirer": "^14.2.2",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.6.2",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
